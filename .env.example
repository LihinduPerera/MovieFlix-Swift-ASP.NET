# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# never commit real secrets.

# --- Secrets (required) ---

# A strong, unique JWT signing key, at least 32 bytes.
# Generate one e.g. with: openssl rand -base64 48
JWT_KEY=

# TMDB API read access token from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# --- Optional overrides ---

# Database provider for the API container: Sqlite (default) or Postgres.
DATABASE_PROVIDER=Sqlite

# Only used when DATABASE_PROVIDER=Postgres. Defaults to the bundled `db`
# service below; point this at your own PostgreSQL instance to override.
# POSTGRES_CONNECTION=Host=db;Port=5432;Database=movieflix;Username=movieflix;Password=changeme

# Password for the optional bundled `db` service.
POSTGRES_PASSWORD=movieflix
