{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "RateLimiting": {
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MovieFlix.db"
  },

  "Jwt": {
    "Issuer": "MovieFlix.Api",
    "Audience": "MovieFlix.Client",
    "Key": ""
  },

  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3/",
    "AccessToken": "",
    "Warmup": {
      "Enabled": false,
      "MovieIds": []
    }
  }
}