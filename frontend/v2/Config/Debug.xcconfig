#include "Base.xcconfig"

// The API base URL is injected into Info.plist as `APIBaseURL` and read at
// runtime by AppConfiguration. Change this value (or Config/Local.xcconfig)
// without touching Swift code.
//
// The default points at the development backend running on the local Wi-Fi
// network. That Kestrel instance serves plain HTTP; Debug's ATS exception
// allows it. Use Config/Local.xcconfig for an HTTPS or different host.
// Note the `$()` between the two slashes: xcconfig treats `//` as a comment.
API_BASE_URL = http:/$()/10.35.255.69:7014

// TMDB image CDN root. Individual DTOs only contain relative poster paths.
TMDB_IMAGE_BASE_URL = https:/$()/image.tmdb.org/t/p

// Debug builds use Info-Debug.plist, which carries a local-development-only
// ATS exception. Release never allows cleartext HTTP.

// Optional local override (git-ignored). Keep this last so it wins.
#include? "Local.xcconfig"
